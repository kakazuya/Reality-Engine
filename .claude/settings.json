{
  "permissions": {
    "ask": [
      "Bash(rm *tasks/STATE.md*)",
      "Bash(rm *tasks/TASKS.md*)",
      "Bash(rm *tasks/TASKS_DONE.md*)",
      "Bash(git rm *tasks/STATE.md*)",
      "Bash(git rm *tasks/TASKS.md*)",
      "Bash(git rm *tasks/TASKS_DONE.md*)",
      "PowerShell(Remove-Item *tasks*STATE.md*)",
      "PowerShell(Remove-Item *tasks*TASKS.md*)",
      "PowerShell(Remove-Item *tasks*TASKS_DONE.md*)"
    ],
    "deny": [
      "Read(tasks/archive/**)",
      "Read(.tmp/**)",
      "Read(plugins/dsh-worker/runtime/**)",
      "Read(//d/Shivam_Private/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/reality_engine/scripts/load_context.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/reality_engine/scripts/job_watch.py\" status",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/reality_engine/scripts/session_hooks.py\" stop",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/reality_engine/scripts/session_hooks.py\" precompact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
