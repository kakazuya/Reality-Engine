{
  "permissions": {
    "ask": [
      "Bash(python -m reality_engine.scripts.task_board done * --shivam*)"
    ],
    "deny": [
      "Read(tasks/archive/**)",
      "Read(.tmp/**)",
      "Read(plugins/dsh-worker/runtime/**)",
      "Read(//d/Shivam_Private/**)",
      "Edit(tasks/TASKS.md)",
      "Edit(tasks/TASKS_DONE.md)",
      "Write(tasks/TASKS.md)",
      "Write(tasks/TASKS_DONE.md)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/reality_engine/scripts/load_context.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/reality_engine/scripts/job_watch.py\" status",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/reality_engine/scripts/session_hooks.py\" stop",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/reality_engine/scripts/session_hooks.py\" precompact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
