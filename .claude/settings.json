{
  "permissions": {
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git worktree remove *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(rclone delete *)",
      "Bash(rclone purge *)",
      "Bash(rclone deletefile *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(rm *)"
    ],
    "deny": [
      "Read(tasks/archive/**)",
      "Read(.tmp/**)",
      "Read(plugins/dsh-worker/runtime/**)",
      "Read(//d/Shivam_Private/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/reality_engine/scripts/load_context.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/reality_engine/scripts/job_watch.py\" status",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/reality_engine/scripts/session_hooks.py\" stop",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/reality_engine/scripts/session_hooks.py\" precompact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
