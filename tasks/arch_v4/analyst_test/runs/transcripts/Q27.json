     {
      "chunk_id": 49226,
      "doc_id": "sha256:70d4b23f6e77f91c17e600d514202f6cc55a25a20606d036154f4ba441a8f6ac",
      "doc_type": "deck",
      "header": "HINDALCO · INE038A01020 · Investor deck · - · News Release · p2 · known 2026-02-11T17:50:07",
      "section": "News Release",
      "speaker": null,
      "known_at": "2026-02-11T17:50:07",
